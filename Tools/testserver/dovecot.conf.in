# Dovecot config for LiteMail integration tests. Runs unprivileged on 127.0.0.1.
# @ROOT@, @USER@, @GROUP@, @UID@, @GID@, @IMAP_PORT@ are filled in by run.sh.
dovecot_config_version = 2.4.5
dovecot_storage_version = 2.4.5

base_dir = @ROOT@/run
state_dir = @ROOT@/state
log_path = @ROOT@/dovecot.log
info_log_path = @ROOT@/dovecot.log
listen = 127.0.0.1

# macOS: RLIM_INFINITY is 2^63-1, but Dovecot's "unlimited" passes 2^64-1 and
# setrlimit(RLIMIT_DATA) fails with EPERM. A concrete 1 TB limit works.
default_vsz_limit = 1T
default_process_limit = 300
default_client_limit = 2000

protocols {
  imap = yes
}

default_internal_user = @USER@
default_internal_group = @GROUP@
default_login_user = @USER@

auth_allow_cleartext = yes
auth_mechanisms = plain login

# Tests expect IDLE to report new mail within a second or two.
mailbox_idle_check_interval = 1s

mail_driver = maildir
mail_path = ~/Maildir
mail_home = @ROOT@/home/%{user}

passdb static {
  password = test
}

userdb static {
  fields {
    uid = @UID@
    gid = @GID@
    home = @ROOT@/home/%{user}
  }
}

namespace inbox {
  inbox = yes
  separator = /
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
}

# TLS is terminated by tls_front.py: Dovecot 2.4.5 on macOS closes TLS sessions
# right after login (post-login TLS proxy bug), so Dovecot itself serves plaintext.
ssl = no

service imap-login {
  chroot =
  inet_listener imap {
    port = @IMAP_PORT@
  }
}

service anvil {
  chroot =
}
